# Copy to .env and fill in. NEVER commit .env.

# Shared secret the app sends in `hello`. Make one with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
GARBIS_TOKEN=change-me

# Ollama runs on this same box.
OLLAMA_HOST=http://127.0.0.1:11434

# Twitch "clip that" command (rotate the old values first, see PLAN.md §9)
TWITCH_CLIENT_ID=
TWITCH_BROADCASTER_ID=
TWITCH_USER_TOKEN=
